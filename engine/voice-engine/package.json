{
  "name": "voice-engine",
  "private": true,
  "description": "CallYourCode voice engine: sherpa-onnx kokoro TTS + offline whisper STT behind the /tts /stt /stt-stream contract",
  "scripts": {
    "start": "bun run src/server.ts",
    "test": "bun test src",
    "test:audio": "bun test src/audio",
    "test:stt": "bun test src/stt",
    "test:tts": "bun test src/tts",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.6"
  },
  "devDependencies": {
    "bun-types": "1.2.0",
    "typescript": "5.7.3"
  }
}
