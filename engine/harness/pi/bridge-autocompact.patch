+	// End any in-flight CC query the same way a pi-driven abort does. Auto-compaction
+	// (threshold/overflow) rewrites pi's history but never aborts the agent, so a
+	// long-lived bridge query (one CC query serves a whole tool loop) keeps being fed
+	// tool results and steers and re-serves the full pre-compaction context, which
+	// re-trips the threshold and compacts again without end. Tearing the query down
+	// makes pi's next turn a fresh query; the tool result pi then delivers is rebuilt
+	// into a continuation query by the orphaned-result path (compactionContinuationPending),
+	// so the task keeps going on the compacted history instead of stalling. Manual
+	// /compact already aborts via AgentSession.compact(), so there is nothing live to
+	// end there. Returns how many queries were ended.
+	const abortInFlightForCompaction = (label: string): number => {
+		const live = [...activeQueryContexts].filter(
+			(c) => c.activeQuery !== null && typeof c.abortForCompaction === "function",
+		);
+		for (const c of live) {
+			debug(`${label}: aborting in-flight CC query to force rebuild from compacted context`);
+			c.abortForCompaction!();
+		}
+		return live.length;
+	};
+
